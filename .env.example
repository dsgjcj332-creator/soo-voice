# ==============================================================
# SERVER-SIDE SECRETS — never expose these to the browser bundle.
# On Vercel, set them in Project Settings → Environment Variables.
# ==============================================================

# Gemini API key. Used ONLY by serverless functions to mint short-lived
# ephemeral tokens for the voice widget (see /api/gemini-session).
GEMINI_API_KEY=""

# Shared secret for inbound webhooks. Requests must send
# `x-soovoice-signature: sha256=<hex hmac of the RAW body>` to be accepted.
WEBHOOK_SECRET=""

# API key required by admin/data API routes via the `x-api-key` header.
API_KEY=""

# Public URL of the deployment (used for OAuth callbacks and self-referential links).
APP_URL=""

# Optional: comma-separated CORS origin allowlist, e.g.
# "https://app.soovoice.com,https://merchant-store.com".
# Leave empty to allow all origins (required while the widget is embedded
# on arbitrary merchant storefronts).
ALLOWED_ORIGINS=""

# ==============================================================
# SUPABASE (client-side) — the anon key is designed to be public.
# ==============================================================
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Server-only Supabase admin access for trusted guest order creation/tracking.
# Never prefix this key with VITE_ or expose it to the browser.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Server-only HMAC secret (at least 32 random characters) used to derive
# per-order guest capability tokens. Rotate only with an explicit migration plan.
ORDER_TOKEN_SECRET=""

# POS connection endpoints verify merchant access tokens against Supabase Auth using SUPABASE_ANON_KEY.
# The browser may still use VITE_SUPABASE_ANON_KEY; this server variable is runtime configuration.

# Server-only AES-256-GCM key for POS provider credentials (base64-encoded 32 random bytes).
# Generate with: openssl rand -base64 32. Never prefix with VITE_ or commit a real value.
POS_CREDENTIALS_ENCRYPTION_KEY=""
POS_CREDENTIALS_ENCRYPTION_KEY_VERSION="v1"

# Server-only bearer secret (at least 32 random characters) for the scheduled
# POS outbox dispatcher at /api/pos/outbox/dispatch. Store the same value in
# GitHub Actions as POS_OUTBOX_WORKER_SECRET; never expose it to the browser.
POS_OUTBOX_WORKER_SECRET=""

# Scheduled job bearer secret (vercel.json cron) required by cron-only routes.
CRON_SECRET=""

# ==============================================================
# PAYMENTS & SUBSCRIPTIONS (Stripe) — server-only, never in the browser bundle.
# Leave both empty to keep billing routes in their explicit "not configured"
# 503 state; nothing is charged and no subscription row is written.
# ==============================================================

# Stripe secret key (sk_test_... / sk_live_...) used to create subscription
# Checkout Sessions and to cancel/resume merchant subscriptions.
STRIPE_SECRET_KEY=""

# Stripe webhook endpoint signing secret (whsec_...) shown when the webhook
# endpoint is registered in the Stripe Dashboard. Requests to
# /api/billing/webhooks/stripe are rejected without a valid v1 signature.
STRIPE_WEBHOOK_SECRET=""

# Optional absolute URLs Stripe redirects to after Checkout. Defaults to the
# request origin when empty.
BILLING_CHECKOUT_SUCCESS_URL=""
BILLING_CHECKOUT_CANCEL_URL=""

# ==============================================================
# FOODICS POS OAUTH — server-only provider app credentials.
# ==============================================================

# Foodics partner app credentials used by /api/pos/foodics/oauth/*.
# Without them the OAuth routes answer 503 and connections are display-only.
FOODICS_CLIENT_ID=""
FOODICS_CLIENT_SECRET=""
