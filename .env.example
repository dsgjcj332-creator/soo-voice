# ==============================================================
# SERVER-SIDE SECRETS — never expose these to the browser bundle.
# On Vercel, set them in Project Settings → Environment Variables.
# ==============================================================

# Gemini API key. Used ONLY by serverless functions to mint short-lived
# ephemeral tokens for the voice widget (see /api/gemini-session).
GEMINI_API_KEY=""

# Shared secret for inbound webhooks. Requests must send
# `x-soovoice-signature: sha256=<hex hmac of the RAW body>` to be accepted.
WEBHOOK_SECRET=""

# API key required by admin/data API routes via the `x-api-key` header.
API_KEY=""

# Public URL of the deployment (used for OAuth callbacks and self-referential links).
APP_URL=""

# Optional: comma-separated CORS origin allowlist, e.g.
# "https://app.soovoice.com,https://merchant-store.com".
# Leave empty to allow all origins (required while the widget is embedded
# on arbitrary merchant storefronts).
ALLOWED_ORIGINS=""

# ==============================================================
# SUPABASE (client-side) — the anon key is designed to be public.
# ==============================================================
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Server-only Supabase admin access for trusted guest order creation/tracking.
# Never prefix this key with VITE_ or expose it to the browser.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Server-only HMAC secret (at least 32 random characters) used to derive
# per-order guest capability tokens. Rotate only with an explicit migration plan.
ORDER_TOKEN_SECRET=""
